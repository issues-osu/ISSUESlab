plot_scan <- function(manner, lags = 1:5) {
d <- build_daily_dataset(df, chi_heat, manner)
fam_use <- family_for_manner(manner)
sc <- scan_lags(d, lags = lags, fam_use = fam_use)
sc_ok <- dplyr::filter(sc, usable)
if (nrow(sc_ok) == 0) {
return(ggplot() + annotate("text", x = 0.5, y = 0.5, label = paste("No usable lags for", manner), size = 5) + theme_void())
}
ggplot(sc_ok, aes(x = lag, y = RR)) +
geom_point() + geom_line() +
geom_errorbar(aes(ymin = lo, ymax = hi), width = 0.2) +
geom_hline(yintercept = 1, linetype = "dashed") +
labs(title = paste("Lag RR for", manner, "(per +1°C above P75)"), y = "RR", x = "Lag (days)") +
theme_minimal(base_size = 14)
}
