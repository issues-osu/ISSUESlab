heat_avg <- chi_heat %>% summarise(m = mean(tmax_c, na.rm = TRUE)) %>% pull(m)
p_map <- ggplot() +
geom_sf(data = chi_bounds, fill = "white", color = "black", linewidth = 0.4) +
geom_raster(data = kde_df_clip, aes(x = x, y = y, fill = density), interpolate = TRUE, alpha = 0.8) +
scale_fill_viridis_c(name = "Suicide Density", option = "inferno",
guide = guide_colorbar(title.position = "top", barheight = unit(70, "pt"))) +
ggnewscale::new_scale_fill() +
geom_sf(data = adi_subset, aes(fill = factor(ADI_q)), color = "white", size = 0.1, alpha = 0.5) +
scale_fill_brewer(palette = "Purples", name = "ADI Quintile", labels = paste0("Q", 1:5),
guide = guide_legend(title.position = "top")) +
labs(title = "Suicide Deaths (65+) in Chicago, 2016–2024",
subtitle = paste0("Avg summer Tmax ≈ ", round(heat_avg, 1), " °C")) +
theme_void(base_size = 16) +
theme(plot.title.position = "plot",
legend.position = "right",
legend.box = "vertical",
legend.background = element_rect(fill = scales::alpha("white", 0.75), color = NA),
plot.margin = margin(8, 8, 8, 8))
print(p_map)
# Save (optional)
ggsave("plot_rr_accident.png", p_acc,  width = 7, height = 5, dpi = 300)
ggsave("plot_rr_suicide.png",  p_sui,  width = 7, height = 5, dpi = 300)
ggsave("plot_rr_homicide.png", p_hom,  width = 7, height = 5, dpi = 300)
ggsave("plot_rr_natural.png",  p_nat,  width = 7, height = 5, dpi = 300)
ggsave("plot_monthly_counts.png", p_monthly, width = 8, height = 5, dpi = 300)
ggsave("map_suicide_kde_adi.png", p_map,     width = 8, height = 6, dpi = 300)
death_with_temp <- df %>%
dplyr::filter(!is.na(incident_date)) %>%
dplyr::left_join(
chi_heat %>%
dplyr::select(date, tmax_c, heat_threshold_c, dplyr::starts_with("Theat")),
by = c("incident_date" = "date")
)
suicide65 <- df %>%
filter(!is.na(longitude), !is.na(latitude), !is.na(incident_date),
Age >= 19 & Age <= 34, Manner.of.Death == "HOMICIDE") %>%
mutate(year = year(incident_date)) %>%
sf::st_as_sf(coords = c("longitude","latitude"), crs = 4326, remove = FALSE) %>%
sf::st_transform(sf::st_crs(chi_bounds))
bb <- sf::st_bbox(chi_bounds)
cc <- sf::st_coordinates(suicide65)
kd <- MASS::kde2d(x = cc[,1], y = cc[,2], n = c(250,250),
lims = c(bb["xmin"], bb["xmax"], bb["ymin"], bb["ymax"]))
kde_df <- cbind(expand.grid(x = kd$x, y = kd$y), density = as.vector(kd$z))
kde_pts <- sf::st_as_sf(kde_df, coords = c("x","y"),
crs = sf::st_crs(chi_bounds), remove = FALSE)
inside <- sf::st_within(kde_pts, chi_bounds, sparse = FALSE)[,1]
kde_df_clip <- kde_pts[inside, ] %>% sf::st_drop_geometry()
adi_poly   <- sf::st_transform(adi22, sf::st_crs(chi_bounds))
adi_subset <- adi_poly[chi_bounds, ]
qbreaks <- stats::quantile(adi_subset$ADI, probs = seq(0,1,0.2), na.rm = TRUE)
if (length(unique(qbreaks)) < 5) qbreaks <- pretty(adi_subset$ADI, n = 5)
adi_subset$ADI_q <- cut(adi_subset$ADI, breaks = qbreaks, include.lowest = TRUE, labels = FALSE)
heat_avg <- chi_heat %>% summarise(m = mean(tmax_c, na.rm = TRUE)) %>% pull(m)
p_map <- ggplot() +
geom_sf(data = chi_bounds, fill = "white", color = "black", linewidth = 0.4) +
geom_raster(data = kde_df_clip, aes(x = x, y = y, fill = density), interpolate = TRUE, alpha = 0.8) +
scale_fill_viridis_c(name = "Suicide Density", option = "inferno",
guide = guide_colorbar(title.position = "top", barheight = unit(70, "pt"))) +
ggnewscale::new_scale_fill() +
geom_sf(data = adi_subset, aes(fill = factor(ADI_q)), color = "white", size = 0.1, alpha = 0.5) +
scale_fill_brewer(palette = "Purples", name = "ADI Quintile", labels = paste0("Q", 1:5),
guide = guide_legend(title.position = "top")) +
labs(title = "Suicide Deaths (65+) in Chicago, 2016–2024",
subtitle = paste0("Avg summer Tmax ≈ ", round(heat_avg, 1), " °C")) +
theme_void(base_size = 16) +
theme(plot.title.position = "plot",
legend.position = "right",
legend.box = "vertical",
legend.background = element_rect(fill = scales::alpha("white", 0.75), color = NA),
plot.margin = margin(8, 8, 8, 8))
print(p_map)
