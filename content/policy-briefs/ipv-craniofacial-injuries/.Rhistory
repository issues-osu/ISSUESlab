std_adi <- function(x) {
nm <- names(x)
geoid_col <- dplyr::case_when("GEOID" %in% nm ~ "GEOID",
"GEOID_BG" %in% nm ~ "GEOID_BG",
TRUE ~ NA_character_)
adi_col   <- dplyr::case_when("ADI" %in% nm ~ "ADI",
"ADI_NATRANK" %in% nm ~ "ADI_NATRANK",
TRUE ~ NA_character_)
if (is.na(geoid_col)) stop("No GEOID column in ADI data")
if (is.na(adi_col))   stop("No ADI column in ADI data")
x %>% dplyr::select(GEOID = dplyr::all_of(geoid_col), ADI   = dplyr::all_of(adi_col), geometry)
}
