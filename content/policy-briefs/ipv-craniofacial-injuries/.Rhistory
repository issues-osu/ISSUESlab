Theat3 = dplyr::lag(Theat, 3),
Theat4 = dplyr::lag(Theat, 4),
Theat5 = dplyr::lag(Theat, 5),
heat_threshold_c = thr
)
}
family_for_manner <- function(manner) if (toupper(manner) == "HOMICIDE") "poisson" else "nb"
safe_vcov <- function(fit, fam_use) {
if (fam_use == "nb") stats::vcov(fit) else
tryCatch(sandwich::vcovHC(fit, type = "HC0"), error = function(e) stats::vcov(fit))
}
# Note: DOW enters as explicit dummies (+ 0 + dow); no intercept for DOW block
model_formula <- function(yvar, heat_term) {
paste0(
yvar, " ~ ", heat_term,
" + n1 + summer + sin90 + cos90 + sin120 + cos120 + I(log(lag_y + 1))",
" + 0 + dow"
)
}
scan_lags <- function(d, lags = 1:5, yvar = "y", fam_use = c("poisson","nb")) {
fam_use <- match.arg(fam_use)
purrr::map_dfr(lags, function(L) {
term <- paste0("Theat", L)
v <- d[[term]]
usable <- !is.null(v) && any(is.finite(v)) && stats::sd(v, na.rm = TRUE) > 0 && any(v > 0, na.rm = TRUE)
f <- stats::as.formula(model_formula(yvar, term))
if (usable) {
fit <- if (fam_use == "nb") suppressWarnings(MASS::glm.nb(f, data = d))
else                  suppressWarnings(stats::glm(f, data = d, family = stats::poisson()))
V <- safe_vcov(fit, fam_use); cf <- stats::coef(fit)
if (!is.null(V) && (term %in% names(cf)) && (term %in% rownames(V))) {
b <- cf[[term]]; se <- sqrt(V[term, term])
return(dplyr::tibble(lag = L, term = term, RR = exp(b),
lo = exp(b - 1.96*se), hi = exp(b + 1.96*se),
AIC = stats::AIC(fit), family = fam_use, usable = TRUE))
}
}
dplyr::tibble(lag = L, term = term, RR = NA_real_, lo = NA_real_, hi = NA_real_,
AIC = Inf, family = fam_use, usable = FALSE)
})
}
stepwise_back <- function(formula, data, fam_use, min_p = 0.05,
protect_regex = "^(Theat[1-5]|I\\(log\\(lag_y \\+ 1\\)\\))$",
max_iter = 20) {
fit_once <- function(fml) if (fam_use == "nb") MASS::glm.nb(fml, data = data) else glm(fml, data = data, family = poisson())
fit <- suppressWarnings(fit_once(formula))
iter <- 0
repeat {
iter <- iter + 1; if (iter > max_iter) break
co <- summary(fit)$coefficients
ptab <- data.frame(term = rownames(co), p = co[, ncol(co)], stringsAsFactors = FALSE)
ptab <- subset(ptab, term != "(Intercept)" & !grepl(protect_regex, term))
if (!nrow(ptab)) break
worst <- ptab[which.max(ptab$p), ]
if (is.na(worst$p) || worst$p < min_p) break
rhs <- labels(terms(formula)); rhs_new <- setdiff(rhs, worst$term)
formula <- as.formula(paste(all.vars(formula)[1], "~", paste(rhs_new, collapse = " + ")))
fit <- suppressWarnings(fit_once(formula))
}
fit
}
