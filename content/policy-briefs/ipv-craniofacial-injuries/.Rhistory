adi16 <- sf::st_transform(adi16, sf::st_crs(df_pts))
adi19 <- sf::st_transform(adi19, sf::st_crs(df_pts))
adi22 <- sf::st_transform(adi22, sf::st_crs(df_pts))
adi10 <- sf::st_make_valid(adi10); adi16 <- sf::st_make_valid(adi16); adi19 <- sf::st_make_valid(adi19); adi22 <- sf::st_make_valid(adi22)
join_get <- function(pts, adi) {
j <- sf::st_join(pts, adi, join = sf::st_within, left = TRUE)
miss <- which(is.na(j$GEOID))
if (length(miss)) {
nn <- sf::st_nearest_feature(j[miss,], adi)
j$GEOID[miss] <- adi$GEOID[nn]
j$ADI[miss]   <- adi$ADI[nn]
}
j %>% sf::st_drop_geometry() %>% dplyr::select(row_id, ADI, GEOID)
}
p10 <- join_get(df_pts, adi10) %>% rename(ADI_2010 = ADI, GEOID_2010 = GEOID)
p16 <- join_get(df_pts, adi16) %>% rename(ADI_2016 = ADI, GEOID_2016 = GEOID)
p19 <- join_get(df_pts, adi19) %>% rename(ADI_2019 = ADI, GEOID_2019 = GEOID)
p22 <- join_get(df_pts, adi22) %>% rename(ADI_2022 = ADI, GEOID_2022 = GEOID)
adi_single <- df_pts %>%
sf::st_drop_geometry() %>%
left_join(p10, by = "row_id") %>%   # must contain ADI_2010 (and optionally GEOID_2010)
left_join(p16, by = "row_id") %>%
left_join(p19, by = "row_id") %>%
left_join(p22, by = "row_id") %>%
mutate(
yr  = lubridate::year(incident_date),
d10 = abs(yr - 2010L),
d16 = abs(yr - 2016L),
d19 = abs(yr - 2019L),
d22 = abs(yr - 2022L)
) %>%
# pick the closest year among those with non-missing ADI
rowwise() %>%
mutate(
ADI = {
vals  <- c(ADI_2010, ADI_2016, ADI_2019, ADI_2022)
dists <- c(d10,      d16,      d19,      d22)
# ignore years with NA ADI by setting distance to Inf
dists[is.na(vals)] <- Inf
if (all(is.infinite(dists))) NA_real_ else vals[which.min(dists)]
},
ADI_10 = ADI / 10
) %>%
ungroup() %>%
dplyr::select(row_id, ADI, ADI_10)
df <- df %>% left_join(adi_single, by = "row_id")
# ---------------------------
# 4) Build daily dataset (65+) by manner
# ---------------------------
build_daily_dataset <- function(df, chi_heat, manner) {
d_sub <- df %>%
filter(!is.na(incident_date), Age >= 18, Manner.of.Death == manner) %>%
count(date = incident_date, name = "y")
chi_heat %>%
left_join(tibble(date = chi_heat$date) %>%
left_join(d_sub, by = "date") %>%
mutate(y = tidyr::replace_na(y, 0L)),
by = "date") %>%
arrange(date) %>%
mutate(
n1     = row_number(),
dow    = wday(date, label = TRUE, abbr = FALSE, week_start = 1),
summer = as.integer(month(date) %in% c(7, 8)),
t_idx  = as.numeric(date - min(date)) + 1,
sin90  = sin(2*pi*t_idx/90),  cos90  = cos(2*pi*t_idx/90),
sin120 = sin(2*pi*t_idx/120), cos120 = cos(2*pi*t_idx/120),
lag_y  = lag(y, 1, default = 0L)
)
}
# ---------------------------
# 5) Analyze one manner; choose lag & family; stepwise; AR & AC
# ---------------------------
fit_chosen_lag <- function(d, fam_use, lags = 1:5){
sc <- scan_lags(d, lags = lags, fam_use = fam_use)
sc_ok <- dplyr::filter(sc, usable, is.finite(AIC))
if (nrow(sc_ok) == 0) return(NULL)
bestL <- sc_ok$lag[which.min(sc_ok$AIC)]
term  <- paste0("Theat", bestL)
fit   <- stepwise_back(as.formula(model_formula("y", term)), data = d, fam_use = fam_use, min_p = 0.05)
list(fit=fit, V=safe_vcov(fit, fam_use), lag=bestL, term=term)
}
analyze_manner <- function(df, chi_heat, manner, lags = 1:5) {
fam_use <- family_for_manner(manner)
d <- build_daily_dataset(df, chi_heat, manner)
total <- sum(d$y, na.rm = TRUE)
if (total == 0L) return(tibble(Manner = manner, Deaths_65p = 0L))
fc <- fit_chosen_lag(d, fam_use, lags = lags)
if (is.null(fc)) {
return(tibble(Manner = manner, Deaths_65p = total, Best_lag = NA_integer_,
Family = toupper(fam_use), RR_heat_CI = NA_character_,
Attrib_cases = NA_real_, Attrib_pct_of_total = NA_real_,
Heat_days = sum(d$Theat0 > 0, na.rm = TRUE),
Deg_above_sum = sum(d$Theat0, na.rm = TRUE),
Threshold_C = dplyr::first(d$heat_threshold_c)))
}
heat_term <- fc$term; V <- fc$V
bH  <- coef(fc$fit)[[heat_term]]
seH <- sqrt(V[heat_term, heat_term]); RRH <- exp(bH)
loH <- exp(bH - 1.96*seH); hiH <- exp(bH + 1.96*seH)
arH <- ar_from_rr(RRH, loH, hiH)
doseC  <- d[[heat_term]]
RR_day <- exp(bH * doseC)
AC_day <- d$y * (1 - 1 / RR_day)
AC_tot <- sum(AC_day, na.rm = TRUE)
AC_pct <- if (total > 0) 100 * AC_tot / total else NA_real_
tibble(
Manner              = manner,
Deaths_65p          = total,
Best_lag            = fc$lag,
Family              = toupper(fam_use),
RR_heat_CI          = sprintf("%.3f (%.3f–%.3f)", RRH, loH, hiH),
AR_heat_CI          = sprintf("%.1f%% (%.1f–%.1f)", arH$AR, arH$AR_lo, arH$AR_hi),
Attrib_cases        = AC_tot,
Attrib_pct_of_total = AC_pct,
Heat_days           = sum(d$Theat0 > 0, na.rm = TRUE),
Deg_above_sum       = sum(d$Theat0, na.rm = TRUE),
Threshold_C         = dplyr::first(d$heat_threshold_c)
)
}
# ---------------------------
# 6) Table 2 builder (RR, p, 95% CI) with chosen lag (no ADI)
# ---------------------------
fit_extract <- function(d, best_lag, fam_use = c("poisson","nb")) {
fam_use <- match.arg(fam_use)
term <- paste0("Theat", best_lag)
f <- as.formula(model_formula("y", term))
if (fam_use == "nb") {
fit <- suppressWarnings(MASS::glm.nb(f, data = d)); V <- stats::vcov(fit)
tt  <- broom::tidy(fit) %>% mutate(p = p.value) %>% dplyr::select(term, estimate, p)
} else {
fit <- suppressWarnings(glm(f, data = d, family = poisson()))
V   <- tryCatch(sandwich::vcovHC(fit, type = "HC0"), error = function(e) stats::vcov(fit))
ct  <- lmtest::coeftest(fit, vcov. = V); tt <- broom::tidy(ct) %>% dplyr::select(term, estimate, p = p.value)
}
se <- sqrt(diag(V)); cf <- coef(fit)
rr <- exp(cf); lo <- exp(cf - 1.96*se); hi <- exp(cf + 1.96*se)
out <- tibble(term = names(rr), RR = rr, lo = lo, hi = hi) %>%
left_join(tt, by = "term") %>%
mutate(
label = case_when(
term == "(Intercept)"              ~ NA_character_,
term == "n1"                       ~ "n1",
term == "I(log(lag_y + 1))"        ~ "Autoregressive term",
term == "summer"                   ~ "Summer (Jul-Aug)",
term == "sin90"                    ~ "Sine 90",
term == "cos90"                    ~ "Cosine 90",
term == "sin120"                   ~ "Sine 120",
term == "cos120"                   ~ "Cosine 120",
term == paste0("Theat", best_lag)  ~ paste0("Theat", best_lag),
str_starts(term, "dow")            ~ sub("^dow", "", term),
TRUE ~ term
),
p_str  = dplyr::case_when(is.na(p) ~ NA_character_, p < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p)),
RR_str = ifelse(is.na(RR), NA_character_, sprintf("%.2f", RR)),
CI_str = ifelse(is.na(lo), NA_character_, sprintf("%.2f-%.2f", lo, hi))
) %>%
filter(!is.na(label)) %>%
dplyr::select(label, RR_str, p_str, CI_str)
wanted <- c(
"n1","Autoregressive term",
paste0("Theat", 1:5),
c("Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"),
"Sine 90","Cosine 90","Sine 120","Cosine 120","Summer (Jul-Aug)"
)
out %>% mutate(.ord = match(label, wanted)) %>% arrange(.ord, label) %>% dplyr::select(-.ord)
}
build_table2 <- function(df, chi_heat, manners = c("ACCIDENT","SUICIDE","HOMICIDE","NATURAL")) {
pieces <- lapply(manners, function(mn){
d <- build_daily_dataset(df, chi_heat, mn)
if (sum(d$y, na.rm = TRUE) == 0) {
return(tibble(label = character(),
!!paste0(mn,"_RR") := character(),
!!paste0(mn,"_p")  := character(),
!!paste0(mn,"_CI") := character()))
}
famU  <- family_for_manner(mn)
scn   <- scan_lags(d, lags = 1:5, fam_use = famU)   # NOTE: fam_use (not fam)
bestL <- scn$lag[which.min(scn$AIC)]
ests  <- fit_extract(d, bestL, fam_use = famU)
ests %>%
rename(!!paste0(mn,"_RR") := RR_str,
!!paste0(mn,"_p")  := p_str,
!!paste0(mn,"_CI") := CI_str)
})
tab <- Reduce(function(x, y) full_join(x, y, by = "label"), pieces)
wanted <- c(
"n1","Autoregressive term",
paste0("Theat", 1:5),
c("Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"),
"Sine 90","Cosine 90","Sine 120","Cosine 120","Summer (Jul-Aug)"
)
tab %>% mutate(.ord = match(label, wanted)) %>%
arrange(.ord, label) %>%
dplyr::select(-.ord) %>%
rename(Variables = label)
}
