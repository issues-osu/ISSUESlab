rename(Total_Sum = Sum, Total_Avg = Avg, Total_SD = SD) %>%
left_join(hot  %>% rename(H_Sum = Sum, H_Avg = Avg, H_SD = SD),  by = "Variables") %>%
left_join(cool %>% rename(C_Sum = Sum, C_Avg = Avg, C_SD = SD), by = "Variables")
